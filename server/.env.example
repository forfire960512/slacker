# Port the server listens on. Default: 8080.
# PORT=8080

# Signs auth JWTs. If unset, one is generated and saved to data/.jwt-secret
# on first boot so restarts don't invalidate every session — set this
# explicitly for anything beyond solo local dev.
# JWT_SECRET=

# When set, message persistence uses Postgres (see docker-compose.yml for
# a local instance matching these defaults) instead of the zero-setup
# SQLite fallback (data/slacker.db).
# DATABASE_URL=postgres://slacker:slacker@localhost:5432/slacker
